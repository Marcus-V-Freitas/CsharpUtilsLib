<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<id>CsharpUtilsLib</id>
		<Version>0.0.0</Version>
		<authors>Marcus-V-Freitas</authors>
		<owners>Marcus-V-Freitas</owners>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://www.nuget.org/packages/CsharpUtilsLib</PackageProjectUrl>
		<projectUrl>https://github.com/Marcus-V-Freitas/CsharpUtilsLib</projectUrl>
		<RepositoryUrl>https://github.com/Marcus-V-Freitas/CsharpUtilsLib</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<description>Lib containing numerous functions to simplify the day to day development</description>
		<copyright>Copyright 2025</copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.12.*" />		
		<PackageReference Include="MySqlConnector" Version="2.6.1" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="ParquetSharp" Version="23.0.0.2" />
		<PackageReference Include="sqlkata" Version="4.0.*" />
		<PackageReference Include="sqlkata.Execution" Version="4.0.*" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.*" />
		<PackageReference Include="System.IO.pipelines" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="SonarAnalyzer.CSharp" Version="10.27.0.140913" />
	</ItemGroup>
	
</Project>